{
    "schedules": [
        {
            "type": "program",
            "name": "sctrading-webapp",
            "program_class": "processmanager.programs.webapp_program.WebappProgram",
            "keep_alive": true,
            "check_alive_freq": "1 m",
            "max_retries": 9999999,
            "run_on_start": true
        },
        {
            "type": "program",
            "name": "live-pipeline",
            "program_class": "processmanager.programs.live_pipeline_program.LivePipelineProgram",
            "keep_alive": true,
            "check_alive_freq": "1 m",
            "max_retries": 9999999,
            "run_on_start": false,
            "start": "3:50 AM ET",
            "end": "8:00 PM ET",
            "days": [
                "mon",
                "tue",
                "wed",
                "thu",
                "fri"
            ]
        },
        {
            "type": "program",
            "name": "tws",
            "program_class": "processmanager.programs.tws_program.TWS_Program",
            "keep_alive": true,
            "check_alive_freq": "1 m",
            "max_retries": 9999999
        },
        {
            "type": "task",
            "name": "ib-short-costs-snapshot",
            "cmd": [
                "/home/kyle/miniconda3/envs/sctrading/bin/python",
                "/home/kyle/projects/sctrading/src/sctrading/core/ib_short_stock.py",
                "-snapshot"
            ],
            "start": "04:00 am pst",
            "stop": "05:00 pm pst",
            "freq": "5 m",
            "days": [
                "mon",
                "tue",
                "wed",
                "thu",
                "fri"
            ]
        }
    ]
}
